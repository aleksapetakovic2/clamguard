#!/usr/bin/env python3
"""ClamGuard privileged helper — the only part of ClamGuard that runs as root.

It is deliberately small, has no dependencies beyond the Python standard
library, and imports nothing from the ClamGuard package. Read it in full before
installing it; that is the point of keeping it this size.

It is invoked as::

    pkexec /usr/local/lib/clamguard/clamguard-helper <verb> [arguments]

Every verb is listed in VERBS below. Anything else is refused. Paths and unit
names are checked against allow-lists *here*, not in the GUI, so a bug in the
GUI cannot turn into an arbitrary root write. Every invocation is appended to
/var/log/clamguard-helper.log.

Exit codes
    0   success
    1   the operation failed (the reason is on stderr)
    2   the request was refused — bad verb, bad path, bad unit

Threat model
    pkexec has already authenticated the caller as an administrator, so this
    helper is not a barrier against a user who wants root; they have it. It is
    a barrier against *mistakes* — a malformed path from the GUI, a wrong unit
    name, a config file that would stop clamd from starting — and against a
    compromised GUI, or anything else running as the user, reusing the few
    minutes auth_admin_keep leaves after a legitimate action. That is why a
    quarantine is verified with ClamAV here, why a restore destination comes
    from this helper's own record, and why every path the user could race is
    walked a directory at a time without following symlinks.
"""

from __future__ import annotations

import contextlib
import errno
import grp
import hashlib
import json
import os
import pwd
import re
import shutil
import stat as stat_module
import subprocess
import sys
import tempfile
import time
from pathlib import Path

VERSION = "1.0.0"
LOG_PATH = Path("/var/log/clamguard-helper.log")

# ---------------------------------------------------------------------------
# Allow-lists. Nothing outside these is touched, ever.
# ---------------------------------------------------------------------------

#: Configuration files this helper may read and replace.
CONFIG_FILES = frozenset({
    "/etc/clamav/clamd.conf",
    "/etc/clamav/freshclam.conf",
    "/etc/clamav/clamav-milter.conf",
    "/etc/clamd.conf",
    "/etc/freshclam.conf",
    "/etc/clamav-milter.conf",
    "/usr/local/etc/clamav/clamd.conf",
    "/usr/local/etc/clamav/freshclam.conf",
})

#: Log files this helper may read. Reading is harmless, but keep it narrow.
LOG_FILES = frozenset({
    "/var/log/clamav/clamd.log",
    "/var/log/clamav/freshclam.log",
    "/var/log/clamav/clamonacc.log",
    "/var/log/clamguard-helper.log",
})

#: systemd units this helper may control.
UNITS = frozenset({
    "clamav-daemon.service",
    "clamav-freshclam.service",
    "clamav-clamonacc.service",
    "clamav-daemon.socket",
    "clamd.service",
    "clamd@scan.service",
    "freshclam.service",
    "clamonacc.service",
})

#: systemctl verbs this helper may pass through.
UNIT_ACTIONS = frozenset({"start", "stop", "restart", "reload", "enable", "disable"})

#: Restoring a quarantined file into any of these is refused outright. This is
#: defence in depth only — the real protection is that a restore destination
#: never comes from the caller at all, but from this helper's own record of
#: what it quarantined (see RECORD_DIR).
FORBIDDEN_RESTORE_PREFIXES = (
    "/usr/", "/bin/", "/sbin/", "/lib/", "/lib64/", "/boot/",
    "/proc/", "/sys/", "/dev/", "/run/",
    "/etc/polkit-1/", "/etc/sudoers", "/etc/pam.d/", "/etc/systemd/",
    "/etc/ssh/", "/etc/shadow", "/etc/passwd", "/etc/group", "/etc/gshadow",
    "/etc/cron", "/etc/profile.d/", "/etc/init.d/", "/etc/rc.d/",
    "/etc/ld.so.conf", "/etc/ld.so.preload", "/etc/environment",
    "/var/spool/cron", "/root/",
)

#: Where this helper keeps its own account of what it quarantined. Root-owned
#: and unreadable to the user, so a restore destination cannot be forged by
#: editing a file in the user's home directory.
RECORD_DIR = Path("/var/lib/clamguard/records")

#: Quarantine entry identifiers, as generated by clamguard/core/quarantine.py.
ENTRY_ID = re.compile(r"^\d{8}-\d{6}-[0-9a-f]{6}$")

#: Vault payload file names: an entry id and the extension the app gives it.
PAYLOAD_NAME = re.compile(r"^\d{8}-\d{6}-[0-9a-f]{6}\.quar$")

#: The byte pattern ClamGuard XORs quarantined payloads with. This is
#: *neutralisation*, not encryption: it stops a double-click from running the
#: file and stops a re-scan of the vault from alerting on it. It is not a
#: secret and is not meant to be.
NEUTRALISE_KEY = b"ClamGuardVault01"

#: The largest file this helper will move in or out of the vault. Malware
#: samples are small; a cap keeps a mistake from reading a whole disk image
#: into memory as root.
MAX_QUARANTINE_BYTES = 512 * 1024 * 1024

#: The largest config file read-file will print.
MAX_CONFIG_BYTES = 4 * 1024 * 1024

#: How much of a log read-file prints: the end, which is what the Logs page
#: shows. A ClamAV log with rotation off can reach gigabytes, all of which
#: would otherwise be read into memory as root.
LOG_TAIL_BYTES = 4 * 1024 * 1024

VERBS = (
    "status",
    "read-file",
    "write-config",
    "service",
    "update-db",
    "quarantine",
    "restore",
)


# ---------------------------------------------------------------------------
# Plumbing
# ---------------------------------------------------------------------------


def refuse(message: str) -> None:
    """Reject a request that is outside what this helper will do."""
    audit(f"REFUSED {message}")
    print(f"clamguard-helper: refused: {message}", file=sys.stderr)
    sys.exit(2)


def fail(message: str) -> None:
    """Report an operation that was allowed but did not work."""
    audit(f"FAILED {message}")
    print(f"clamguard-helper: {message}", file=sys.stderr)
    sys.exit(1)


def audit(message: str) -> None:
    """Append one line to the helper's own log. Never fatal."""
    caller = os.environ.get("PKEXEC_UID", "?")
    try:
        with LOG_PATH.open("a", encoding="utf-8") as handle:
            handle.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')} uid={caller} {message}\n")
        LOG_PATH.chmod(0o640)
    except OSError:
        pass


def calling_user() -> pwd.struct_passwd:
    """The account that invoked pkexec, not root."""
    uid = os.environ.get("PKEXEC_UID")
    if uid is None:
        refuse("PKEXEC_UID is not set — run this through pkexec, not directly")
    try:
        return pwd.getpwuid(int(uid))
    except (ValueError, KeyError):
        refuse(f"unknown calling uid {uid!r}")


def require_absolute(path: str, what: str) -> Path:
    if not path.startswith("/"):
        refuse(f"{what} must be an absolute path, got {path!r}")
    resolved = Path(path)
    if ".." in resolved.parts:
        refuse(f"{what} must not contain '..'")
    return resolved


def open_directory(path: Path) -> tuple[Path, int]:
    """Open a directory without following a symlink anywhere on the way.

    Every file this helper touches on the user's behalf sits below a directory
    the user may be able to write, so between a check and a use they could
    swap any directory on the path for a symlink. O_NOFOLLOW on the last
    component alone does not stop that. So the path is resolved once, and the
    result walked from / one component at a time with O_NOFOLLOW: a symlink
    that was there all along (Silverblue's /home -> var/home) is resolved first
    and still works, while one swapped in afterwards makes the walk fail
    instead of redirecting it. Everything after that is done relative to the
    descriptor.

    The resolved path comes back with the descriptor because it is the path
    the descriptor is known to refer to. Every check must be made on it, never
    on the path the caller supplied.
    """
    real = Path(os.path.realpath(path))
    descriptor = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
    try:
        for part in real.parts[1:]:
            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                            dir_fd=descriptor)
            os.close(descriptor)
            descriptor = child
    except OSError as error:
        os.close(descriptor)
        fail(f"cannot open {path}: {error}")
    return real, descriptor


def open_vault(path: Path, user: pwd.struct_passwd) -> tuple[Path, int]:
    """Open a directory inside the calling user's own quarantine vault.

    It must also belong to them. Their home is theirs to rearrange, so a vault
    that resolves somewhere root owns is someone pointing it at /etc.
    """
    vault_root = Path(os.path.realpath(
        Path(user.pw_dir) / ".local/share/clamguard/quarantine"))
    real, descriptor = open_directory(path)
    inside = real == vault_root or vault_root in real.parents
    if not inside or os.fstat(descriptor).st_uid != user.pw_uid:
        os.close(descriptor)
        refuse(f"the vault payload must be inside {vault_root}, which must be yours")
    return real, descriptor


def open_file(directory: int, name: str, shown_as: Path,
              limit: int | None) -> tuple[int, os.stat_result]:
    """Open a regular file inside an opened directory, and nothing else.

    O_NOFOLLOW refuses a symlink; O_NONBLOCK stops a FIFO hanging the helper
    before the check below turns it away.
    """
    try:
        descriptor = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
                             dir_fd=directory)
    except OSError as error:
        if error.errno == errno.ELOOP:
            refuse(f"{shown_as} is a symlink; use the file it points at")
        fail(f"cannot open {shown_as}: {error}")
    info = os.fstat(descriptor)
    if not stat_module.S_ISREG(info.st_mode):
        os.close(descriptor)
        refuse(f"{shown_as} is not a regular file")
    if limit is not None and info.st_size > limit:
        os.close(descriptor)
        refuse(f"{shown_as} is larger than this helper will handle ({limit} bytes)")
    return descriptor, info


def read_from(descriptor: int, size: int, offset: int = 0) -> bytes:
    """Read size bytes from offset, however many reads that takes."""
    chunks = []
    while size > 0:
        chunk = os.pread(descriptor, min(size, 1024 * 1024), offset)
        if not chunk:
            break
        chunks.append(chunk)
        size -= len(chunk)
        offset += len(chunk)
    return b"".join(chunks)


def neutralise(data: bytes) -> bytes:
    """XOR with the fixed key. Its own inverse, so it undoes a restore too.

    One big-integer XOR rather than a per-byte loop, which matters because a
    malware sample can be tens of megabytes. Must stay byte-for-byte identical
    to _xor() in clamguard/core/quarantine.py.
    """
    if not data:
        return b""
    key = NEUTRALISE_KEY
    stream = (key * (len(data) // len(key) + 2))[:len(data)]
    return (int.from_bytes(data, "big") ^ int.from_bytes(stream, "big")).to_bytes(len(data), "big")


def write_record(record: dict) -> None:
    """Store this helper's own account of a quarantine, readable only by root."""
    try:
        RECORD_DIR.mkdir(parents=True, exist_ok=True)
        os.chmod(RECORD_DIR, 0o700)
        target = RECORD_DIR / f"{record['id']}.json"
        handle = os.open(str(target), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(handle, "w", encoding="utf-8") as stream:
            json.dump(record, stream, indent=2)
    except OSError as error:
        fail(f"cannot record the quarantine: {error}")


def read_record(entry_id: str) -> dict | None:
    try:
        return json.loads((RECORD_DIR / f"{entry_id}.json").read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None


def forget_record(entry_id: str) -> None:
    try:
        (RECORD_DIR / f"{entry_id}.json").unlink(missing_ok=True)
    except OSError:
        pass


def confirm_infected(data: bytes, shown_as: Path) -> str:
    """Refuse to move bytes that ClamAV does not actually flag.

    This is what stops the quarantine verb being a general "read and delete any
    file as root" primitive. The helper does not take the caller's word that a
    file is malware — it asks ClamAV itself, and fails closed if it cannot.

    It scans the bytes already read, on stdin, rather than a path: a path can
    be pointed at another file between the scan and the read, and then ClamAV
    would have approved something other than what gets moved.
    """
    for program in ("clamdscan", "clamscan"):
        executable = shutil.which(program)
        if not executable:
            continue
        try:
            result = subprocess.run(
                [executable, "--no-summary", "--stdout", "-"],
                input=data, capture_output=True, timeout=300, check=False,
                env={"LC_ALL": "C", "PATH": "/usr/bin:/bin:/usr/sbin:/sbin"},
            )
        except (OSError, subprocess.SubprocessError):
            continue
        for line in result.stdout.decode("utf-8", "replace").splitlines():
            if line.rstrip().endswith(" FOUND"):
                return line.rstrip()[: -len(" FOUND")].rpartition(": ")[2]
        if result.returncode == 0:
            refuse(f"{shown_as} is not detected as malware; refusing to quarantine it")
    fail("no working ClamAV scanner was found, so the file could not be verified")


def find_program(name: str) -> str:
    for directory in ("/usr/bin", "/usr/sbin", "/bin", "/sbin",
                      "/usr/local/bin", "/usr/local/sbin"):
        candidate = os.path.join(directory, name)
        if os.access(candidate, os.X_OK):
            return candidate
    fail(f"{name} is not installed")


# ---------------------------------------------------------------------------
# Verbs
# ---------------------------------------------------------------------------


def verb_status(_args: list[str]) -> None:
    """Report that the helper is installed and what it can do."""
    print(json.dumps({
        "helper": "clamguard-helper",
        "version": VERSION,
        "verbs": list(VERBS),
        "config_files": sorted(CONFIG_FILES),
        "units": sorted(UNITS),
    }, indent=2))


def verb_read_file(args: list[str]) -> None:
    """Print an allow-listed config file, or the end of a log, to stdout.

    Not followed through a symlink: /var/log/clamav belongs to the clamav user,
    and a clamd.log swapped for a link to /etc/shadow must not be printed.
    """
    if len(args) != 1:
        refuse("read-file takes exactly one path")
    path = require_absolute(args[0], "path")
    if str(path) not in CONFIG_FILES | LOG_FILES:
        refuse(f"{path} is not a file this helper will read")

    is_log = str(path) in LOG_FILES
    _directory, directory_fd = open_directory(path.parent)
    try:
        descriptor, info = open_file(directory_fd, path.name, path,
                                     None if is_log else MAX_CONFIG_BYTES)
    finally:
        os.close(directory_fd)
    try:
        start = max(0, info.st_size - LOG_TAIL_BYTES) if is_log else 0
        data = read_from(descriptor, info.st_size - start, start)
    finally:
        os.close(descriptor)
    if start:
        data = data.partition(b"\n")[2]  # begin on a whole line
    sys.stdout.write(data.decode("utf-8", errors="replace"))
    audit(f"read-file {path}")


def verb_write_config(args: list[str]) -> None:
    """Replace a ClamAV config file with the text arriving on stdin.

    In order: validate the proposed content with clamconf, take a timestamped
    backup of the current file, then swap the new one in atomically, keeping
    the original owner and mode.
    """
    if len(args) != 1:
        refuse("write-config takes exactly one path")
    path = require_absolute(args[0], "path")
    if str(path) not in CONFIG_FILES:
        refuse(f"{path} is not a config file this helper will write")

    content = sys.stdin.read()
    if not content.strip():
        refuse("refusing to write an empty configuration file")
    if len(content) > 4 * 1024 * 1024:
        refuse("configuration file is implausibly large")

    problems = validate_config(path.name, content)
    if problems:
        fail("the proposed configuration is not valid:\n  " + "\n  ".join(problems))

    backup = ""
    if path.exists():
        backup = f"{path}.clamguard-{time.strftime('%Y%m%d-%H%M%S')}.bak"
        try:
            shutil.copy2(path, backup)
        except OSError as error:
            fail(f"cannot back up {path}: {error}")
        stat = path.stat()
        mode, uid, gid = stat.st_mode & 0o7777, stat.st_uid, stat.st_gid
    else:
        mode, uid, gid = 0o644, 0, 0

    try:
        handle, temporary = tempfile.mkstemp(dir=str(path.parent), prefix=".clamguard-")
        with os.fdopen(handle, "w", encoding="utf-8") as stream:
            stream.write(content)
        os.chmod(temporary, mode)
        os.chown(temporary, uid, gid)
        os.replace(temporary, path)
    except OSError as error:
        fail(f"cannot write {path}: {error}")

    audit(f"write-config {path} backup={backup or 'none'} bytes={len(content)}")
    print(json.dumps({"written": str(path), "backup": backup}))


def validate_config(filename: str, content: str) -> list[str]:
    """Ask clamconf whether it would accept this file.

    clamconf reads a whole directory, so the candidate is written into a
    throwaway directory under its real name and parsed there. Errors come back
    on stdout/stderr as ``ERROR: Parse error at ...``.
    """
    if filename not in ("clamd.conf", "freshclam.conf", "clamav-milter.conf"):
        return []
    clamconf = shutil.which("clamconf") or "/usr/bin/clamconf"
    if not os.access(clamconf, os.X_OK):
        return []  # cannot check; the backup is the safety net

    with tempfile.TemporaryDirectory(prefix="clamguard-check-") as directory:
        candidate = Path(directory) / filename
        candidate.write_text(content, encoding="utf-8")
        try:
            result = subprocess.run(
                [clamconf, "-c", directory],
                capture_output=True, text=True, timeout=30, check=False,
                env={"LC_ALL": "C", "PATH": "/usr/bin:/bin"},
            )
        except (OSError, subprocess.SubprocessError) as error:
            return [f"could not run clamconf: {error}"]

        combined = f"{result.stdout}\n{result.stderr}"
        return [
            line.strip().replace(directory + "/", "")
            for line in combined.splitlines()
            if line.strip().startswith("ERROR:")
        ]


def verb_service(args: list[str]) -> None:
    """Run one systemctl action on one ClamAV unit."""
    if len(args) != 2:
        refuse("service takes an action and a unit name")
    action, unit = args
    if action not in UNIT_ACTIONS:
        refuse(f"{action!r} is not an allowed action")
    if unit not in UNITS:
        refuse(f"{unit!r} is not a ClamAV unit this helper will control")

    systemctl = find_program("systemctl")
    # pkexec already scrubs the environment, but every other subprocess here
    # builds its own and a future edit should not have to remember why this
    # one was different.
    result = subprocess.run([systemctl, action, unit], capture_output=True, text=True,
                            timeout=120, check=False,
                            env={"LC_ALL": "C", "PATH": "/usr/bin:/bin:/usr/sbin:/sbin"})
    audit(f"service {action} {unit} rc={result.returncode}")
    if result.stdout:
        sys.stdout.write(result.stdout)
    if result.returncode != 0:
        fail(result.stderr.strip() or f"systemctl {action} {unit} failed")


def verb_update_db(args: list[str]) -> None:
    """Run freshclam once, streaming its output."""
    if args:
        refuse("update-db takes no arguments")
    freshclam = find_program("freshclam")
    audit("update-db start")
    result = subprocess.run([freshclam, "--stdout"], text=True, timeout=1800, check=False,
                            env={"LC_ALL": "C", "PATH": "/usr/bin:/bin:/usr/sbin:/sbin"})
    audit(f"update-db rc={result.returncode}")
    sys.exit(0 if result.returncode in (0, 1) else 1)


def verb_quarantine(args: list[str]) -> None:
    """Move a file the user cannot touch into their quarantine vault.

    Four things make this safe to expose to a GUI:

    * the file must be one ClamAV itself flags, checked here rather than taken
      on trust, so this cannot be used to read or delete an arbitrary file;
    * every path is walked without following symlinks, and ClamAV scans the
      bytes already read, so nothing can be swapped in between the check and
      the move (see open_directory);
    * the file is only unlinked if its name still means the file that was
      read;
    * what was moved, and from where, is recorded in a root-owned file, which
      is the only thing `restore` will later believe.
    """
    if len(args) != 2:
        refuse("quarantine takes a source path and a vault payload path")
    user = calling_user()
    source = require_absolute(args[0], "source")
    payload = require_absolute(args[1], "payload")
    if not PAYLOAD_NAME.match(payload.name):
        refuse(f"{payload.name} is not a quarantine payload name")
    entry_id = payload.stem

    with contextlib.ExitStack() as opened:
        vault, vault_fd = open_vault(payload.parent, user)
        opened.callback(os.close, vault_fd)
        folder, folder_fd = open_directory(source.parent)
        opened.callback(os.close, folder_fd)

        descriptor, info = open_file(folder_fd, source.name, source, MAX_QUARANTINE_BYTES)
        try:
            data = read_from(descriptor, info.st_size)
            after = os.fstat(descriptor)
        finally:
            os.close(descriptor)
        if len(data) != info.st_size or (after.st_size, after.st_mtime_ns) != (
                info.st_size, info.st_mtime_ns):
            fail(f"{source} changed while it was being read; scan it again")

        threat = confirm_infected(data, source)
        digest = hashlib.sha256(data).hexdigest()

        try:
            handle = os.open(payload.name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                             0o600, dir_fd=vault_fd)
            with os.fdopen(handle, "wb") as stream:
                stream.write(neutralise(data))
                os.fchown(stream.fileno(), user.pw_uid, user.pw_gid)
        except OSError as error:
            fail(f"cannot write the vault payload: {error}")

        record = {
            "id": entry_id,
            # The resolved path, which restore will insist still resolves to
            # the same place.
            "original_path": str(folder / source.name),
            "payload_path": str(vault / payload.name),
            "size": info.st_size,
            # Never preserve setuid, setgid or sticky bits across a quarantine.
            # Restoring one would hand back a root-owned setuid binary.
            "mode": info.st_mode & 0o0777,
            "uid": info.st_uid,
            "gid": info.st_gid,
            "sha256": digest,
            "threat": threat,
            "quarantined_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
            "by_uid": user.pw_uid,
        }
        write_record(record)

        try:
            now = os.stat(source.name, dir_fd=folder_fd, follow_symlinks=False)
            if (now.st_dev, now.st_ino) != (info.st_dev, info.st_ino):
                raise OSError(errno.ESTALE, "it was replaced while being quarantined")
            os.unlink(source.name, dir_fd=folder_fd)
        except OSError as error:
            try:
                os.unlink(payload.name, dir_fd=vault_fd)
            except OSError:
                pass
            forget_record(entry_id)
            fail(f"quarantine aborted, {source} could not be removed: {error}")

    audit(f"quarantine {record['original_path']} -> {record['payload_path']} "
          f"threat={threat} sha256={digest}")
    print(json.dumps({
        "original_path": record["original_path"],
        "size": record["size"],
        "mode": record["mode"],
        "uid": record["uid"],
        "gid": record["gid"],
        "owner": _name_for_uid(info.st_uid),
        "group": _name_for_gid(info.st_gid),
        "sha256": digest,
        "threat": threat,
    }))


def verb_restore(args: list[str]) -> None:
    """Put a quarantined file back where this helper took it from.

    Everything that decides *where* the file lands and *what permissions* it
    gets comes from this helper's own root-owned record, never from the
    caller and never from the metadata in the user's home directory. Without
    that, a caller could hand over a JSON file asking for a root-owned setuid
    binary at a path of their choosing, which is a root shell.

    The file only goes back into the directory it came from, as that path
    resolves *now*. If a directory on the way has since become a symlink to
    somewhere else, the restore is refused rather than followed: otherwise a
    user could quarantine a file from their own folder, point the folder at
    /etc/modprobe.d, and have root write it there. The blocklist below cannot
    name every directory like that; this rule does not need to.
    """
    if len(args) != 1:
        refuse("restore takes one quarantine entry id")
    user = calling_user()
    entry_id = args[0]
    if not ENTRY_ID.match(entry_id):
        refuse(f"{entry_id!r} is not a quarantine entry id")

    record = read_record(entry_id)
    if record is None:
        refuse(f"this helper has no record of quarantining {entry_id}; "
               "only files it moved itself can be restored this way")
    if int(record.get("by_uid", -1)) != user.pw_uid:
        refuse("that file was quarantined by a different user")

    destination = require_absolute(str(record.get("original_path", "")),
                                   "recorded original path")
    for prefix in FORBIDDEN_RESTORE_PREFIXES:
        if str(destination).startswith(prefix):
            refuse(f"restoring into {prefix} must be done by hand, not by ClamGuard")

    payload = require_absolute(str(record.get("payload_path", "")), "payload")
    _vault, vault_fd = open_vault(payload.parent, user)
    try:
        descriptor, info = open_file(vault_fd, payload.name, payload, MAX_QUARANTINE_BYTES)
    finally:
        os.close(vault_fd)
    try:
        data = neutralise(read_from(descriptor, info.st_size))
    finally:
        os.close(descriptor)
    if record.get("sha256") and record["sha256"] != hashlib.sha256(data).hexdigest():
        fail("the vault payload does not match its recorded checksum; "
             "refusing to restore")

    if not destination.parent.is_dir():
        fail(f"{destination.parent} no longer exists; restore it elsewhere")
    folder, folder_fd = open_directory(destination.parent)
    try:
        if folder != destination.parent:
            refuse(f"{destination.parent} now leads to {folder}; a file is only "
                   "put back into the folder it came from")
        try:
            os.stat(destination.name, dir_fd=folder_fd, follow_symlinks=False)
            fail(f"{destination} already exists; remove it first")
        except FileNotFoundError:
            pass

        # Permissions come from the record, with the dangerous bits masked off
        # a second time. Belt and braces: the record was written with them
        # already stripped, but this is the line that must never be wrong.
        mode = int(record.get("mode", 0o600)) & 0o0777
        owner_uid = int(record.get("uid", user.pw_uid))
        owner_gid = int(record.get("gid", user.pw_gid))

        temporary = f".clamguard-{os.urandom(6).hex()}"
        try:
            handle = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                             0o600, dir_fd=folder_fd)
            with os.fdopen(handle, "wb") as stream:
                stream.write(data)
                os.fchmod(stream.fileno(), mode)
                os.fchown(stream.fileno(), owner_uid, owner_gid)
            os.rename(temporary, destination.name, src_dir_fd=folder_fd, dst_dir_fd=folder_fd)
        except (OSError, ValueError) as error:
            try:
                os.unlink(temporary, dir_fd=folder_fd)
            except OSError:
                pass
            fail(f"cannot restore to {destination}: {error}")
    finally:
        os.close(folder_fd)

    forget_record(entry_id)
    audit(f"restore {payload} -> {destination} mode={mode:o}")
    print(json.dumps({"restored": str(destination)}))


def _name_for_uid(uid: int) -> str:
    try:
        return pwd.getpwuid(uid).pw_name
    except KeyError:
        return str(uid)


def _name_for_gid(gid: int) -> str:
    try:
        return grp.getgrgid(gid).gr_name
    except KeyError:
        return str(gid)


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

HANDLERS = {
    "status": verb_status,
    "read-file": verb_read_file,
    "write-config": verb_write_config,
    "service": verb_service,
    "update-db": verb_update_db,
    "quarantine": verb_quarantine,
    "restore": verb_restore,
}


def main(argv: list[str]) -> None:
    if os.geteuid() != 0:
        print("clamguard-helper must be run as root, normally through pkexec.", file=sys.stderr)
        sys.exit(2)
    if not argv:
        print(f"usage: clamguard-helper <{'|'.join(VERBS)}> [arguments]", file=sys.stderr)
        sys.exit(2)

    verb, arguments = argv[0], argv[1:]
    handler = HANDLERS.get(verb)
    if handler is None:
        refuse(f"unknown verb {verb!r}")
    handler(arguments)


if __name__ == "__main__":
    main(sys.argv[1:])
